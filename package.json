{
  "name": "@deepseek-ai/dsh-fusion",
  "description": "Fuse two or more DeepSeek Harness conversations into one durable, continuable session",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.20.0-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.2.0-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.2.0-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-app-boot": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-error": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.vitest.json --pretty false",
    "verify:self-contained": "node scripts/verify-self-contained.mjs",
    "prepare": "node scripts/prepare.mjs",
    "test": "vitest run",
    "test:coverage": "pnpm run build && vitest run --coverage",
    "test:watch": "vitest",
    "pretest": "pnpm run build"
  }
}
